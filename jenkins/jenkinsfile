pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t production-app ./app/nginx'
            }
        }

        stage('Terraform Validation') {
            steps {
                sh 'cd terraform && terraform validate'
            }
        }

        stage('Kubernetes Deployment') {
            steps {
                sh 'kubectl apply -f kubernetes/base/'
            }
        }
    }
}